{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "functions": {
    "api/[...path].mjs": {
      "memory": 4096,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {"source": "/((?!api/).*)", "destination": "/index.html"}
  ]
}
