# Storefront defaults work as-is. Sign-in requires the provider fields below.
API_PORT=3001
# SQLite path, relative to the project root when using pnpm scripts.
DATABASE_PATH=data/osudh24.sqlite

# Firebase web app configuration (public; from Firebase Project settings).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin (server only). Project ID must match the web app above.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Wrap in quotes and use \n for the private key's line breaks.
FIREBASE_PRIVATE_KEY=
# Alternative to CLIENT_EMAIL + PRIVATE_KEY: service account JSON file path.
GOOGLE_APPLICATION_CREDENTIALS=

# MSG91 Widget browser configuration (public; from Client-side integration).
VITE_MSG91_WIDGET_ID=
VITE_MSG91_TOKEN_AUTH=
# MSG91 private Authkey (server only; verifies the widget access token).
MSG91_AUTH_KEY=
# Optional legacy OTP API fallback when the widget fields above are empty.
# Use an approved OTP template with ##OTP##. The widget does not need this ID.
MSG91_TEMPLATE_ID=

# Hosted Postgres (server only; leave empty for local SQLite).
DATABASE_URL=
# Direct connection is used only by the migration CLI.
DIRECT_DATABASE_URL=
# Comma-separated exact HTTPS origins for production.
APP_ORIGINS=
